    "Deleting removes the account and its cloud data. Records on this iPhone stay." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除账号会清除云端的账号和数据，这台 iPhone 上的记录保留。"
