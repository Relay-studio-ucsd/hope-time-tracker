{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ and everything it stored in the cloud will be permanently deleted, and other devices will stop syncing. Records on this iPhone stay." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 以及它在云端的全部记录会被永久删除，其他设备也无法再同步。这台 iPhone 上的记录会保留。"
          }
        }
      }
    },
    "%@ has been running for %@" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」已计时 %2$@"
          }
        }
      }
    },
    "%@ has been running for %@ without a break" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」已连续 %2$@"
